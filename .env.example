# Default sourcing: lcsc uses the public JLCPCB assembly parts catalog (no key).
# Choose digikey to use the optional DigiKey credentials below.
SOURCING_SUPPLIER=lcsc
# Automatically download EasyEDA symbols and footprints after Setup EasyEDA.ps1.
EASYEDA_DOWNLOADS=true

DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_ENV=sandbox
DIGIKEY_SITE=CA
DIGIKEY_LANGUAGE=en
DIGIKEY_CURRENCY=CAD

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

