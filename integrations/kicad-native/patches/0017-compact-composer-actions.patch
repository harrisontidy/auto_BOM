+wxString compactPartText( wxString aText, size_t aLimit )
+{
+    aText.Replace( wxS( "\n" ), wxS( " " ) );
+    aText.Replace( wxS( "\r" ), wxS( " " ) );
+    aText.Trim( true ).Trim( false );
+    if( aText.length() <= aLimit ) return aText;
+    wxString shortened = aText.Left( aLimit );
+    const int space = shortened.Find( ' ', true );
+    if( space > static_cast<int>( aLimit / 2 ) ) shortened = shortened.Left( space );
+    return shortened + wxS( "\u2026" );
+}
