-            aError ? wxSYS_COLOUR_HOTLIGHT : wxSYS_COLOUR_WINDOWTEXT ) );
-    m_statusLabel->Wrap( FromDIP( 290 ) );
+    // Routine state belongs to the conversation/button, not another footer row.
+    // Keep actionable errors visible in the chat instead of silently dropping them.
+    m_statusError = aError ? aMessage : wxString();
+    m_queryCtrl->SetToolTip( aError ? aMessage : _( "Enter to send. Shift+Enter for a new line." ) );
+    renderConversation();
     Layout();
 }
