+void PANEL_AUTO_BOM_ASSISTANT::updateSendButton()
+{
+    const bool active = m_busy || m_revealTimer.IsRunning();
+    m_searchButton->SetLabel( active ? wxS( "\u25A0" ) : wxS( "\u2191" ) );
+    const wxString action = m_busy ? _( "Stop response" ) : m_revealTimer.IsRunning()
+            ? _( "Show full reply" ) : _( "Send message" );
+    m_searchButton->SetName( action );
+    m_searchButton->SetToolTip( action );
+}
