+bool DIALOG_SYMBOL_FIELDS_TABLE::AutoBomCompletionNeeded() const
+{
+    try
+    {
+        const nlohmann::json schematic = nlohmann::json::parse(
+                autoBomUtf8( m_parent->GetAutoBomSchematicJson() ) );
+
+        if( !schematic.contains( "symbols" ) || !schematic["symbols"].is_array() )
+            return true;
+
+        for( const nlohmann::json& symbol : schematic["symbols"] )
+        {
+            const char* requiredPartNumbers[] = {
+                "manufacturerPartNumber",
+                "digiKeyPartNumber"
+            };
+
+            for( const char* fieldName : requiredPartNumbers )
+            {
+                if( !symbol.contains( fieldName ) || !symbol[fieldName].is_string() )
+                    return true;
+
+                wxString partNumber = wxString::FromUTF8(
+                        symbol[fieldName].get<std::string>() );
+                partNumber.Trim( true ).Trim( false );
+
+                if( partNumber.IsEmpty() )
+                    return true;
+            }
+        }
+
+        return false;
+    }
+    catch( const std::exception& )
+    {
+        // Let the completion request report a useful error.  Export still remains available
+        // through the confirmation shown when that request cannot be prepared or completed.
+        return true;
+    }
+}
+
+
+bool DIALOG_SYMBOL_FIELDS_TABLE::ConfirmExportCurrentBom( const wxString& aDetail )
+{
+    wxString message = _( "Auto BOM could not complete every missing DigiKey part number." );
+
+    if( !aDetail.IsEmpty() )
+        message += wxS( "\n\n" ) + aDetail;
+
+    message += _( "\n\nExport the current BOM anyway?" );
+
+    return wxMessageBox( message, _( "BOM Completion Incomplete" ),
+                         wxYES_NO | wxNO_DEFAULT | wxICON_WARNING, this ) == wxYES;
+}
