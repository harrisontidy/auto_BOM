+std::string toUtf8( const wxString& aText )
+{
+    const wxScopedCharBuffer text = aText.utf8_str();
+    return text ? std::string( text.data(), text.length() ) : std::string();
+}
+
+
+wxString fromUtf8( const std::string& aText )
+{
+    return wxString::FromUTF8( aText.data(), aText.size() );
+}
+
+
+wxString jsonText( const nlohmann::json& aObject, const char* aKey )
+{
+    if( !aObject.is_object() || !aObject.contains( aKey ) )
+        return wxString();
+
+    const nlohmann::json& value = aObject[aKey];
+
+    if( value.is_string() )
+        return fromUtf8( value.get<std::string>() );
+
+    if( value.is_number_integer() )
+        return wxString::Format( wxS( "%lld" ), value.get<long long>() );
+
+    if( value.is_number_unsigned() )
+        return wxString::Format( wxS( "%llu" ), value.get<unsigned long long>() );
+
+    if( value.is_number_float() )
+        return wxString::Format( wxS( "%.4f" ), value.get<double>() );
+
+    return wxString();
+}
+
+
+wxString reviewConcerns( const nlohmann::json& aReview )
+{
+    if( !aReview.is_object() || !aReview.contains( "concerns" )
+        || !aReview["concerns"].is_array() )
+    {
+        return wxString();
+    }
+
+    wxString result;
+
+    for( const nlohmann::json& item : aReview["concerns"] )
+    {
+        if( !item.is_string() )
+            continue;
+
+        wxString concern = fromUtf8( item.get<std::string>() );
+        concern.Trim( true ).Trim( false );
+
+        if( concern.IsEmpty() )
+            continue;
+
+        if( !result.IsEmpty() )
+            result += wxS( "\n" );
+
+        result += wxS( "\u2022 " ) + concern;
+    }
+
+    return result;
+}
+
+
+long long jsonInteger( const nlohmann::json& aObject, const char* aKey )
+{
+    if( !aObject.is_object() || !aObject.contains( aKey ) )
+        return 0;
+
+    const nlohmann::json& value = aObject[aKey];
+
+    if( value.is_number_integer() || value.is_number_unsigned() )
+        return value.get<long long>();
+
+    if( value.is_number_float() )
+        return static_cast<long long>( value.get<double>() );
+
+    return 0;
+}
