+void DIALOG_SYMBOL_FIELDS_TABLE::StartAutoBomCompletion( bool aExportWhenDone )
+{
+    if( !m_autoBomComplete || !m_autoBomUseAi || m_autoBomFuture.valid() )
+        return;
+
+    if( !TransferDataFromWindow() )
+        return;
+
+    nlohmann::json request;
+
+    try
+    {
+        request = nlohmann::json::parse( autoBomUtf8( m_parent->GetAutoBomSchematicJson() ) );
+    }
+    catch( const std::exception& )
+    {
+        const wxString message = _( "Could not read the open schematic for BOM completion." );
+
+        if( aExportWhenDone )
+        {
+            if( ConfirmExportCurrentBom( message ) )
+                ExportNow();
+        }
+        else
+        {
+            DisplayError( this, message );
+        }
+
+        return;
+    }
+
+    request["useAi"] = m_autoBomUseAi->IsChecked();
+    m_autoBomExportWhenDone = aExportWhenDone;
+    m_autoBomComplete->Disable();
+    m_autoBomUseAi->Disable();
+    m_buttonExport->Disable();
+    m_grid->Disable();
+    m_variantListBox->Disable();
+    m_autoBomProgress->Show();
+    m_autoBomProgress->Pulse();
+    m_autoBomStatus->SetLabel( _( "Finding in-stock parts..." ) );
+    m_rightPanel->Layout();
+
+    const std::string payload = request.dump();
+    m_autoBomCancel = std::make_shared<std::atomic_bool>( false );
+    const std::shared_ptr<std::atomic_bool> cancel = m_autoBomCancel;
+    m_autoBomFuture = GetKiCadThreadPool().submit_task(
+            [payload, cancel]() -> std::string
+            {
+                return postAutoBomRequest( payload, cancel );
+            } );
+    m_autoBomTimer.Start( 120 );
+}
+
+
+void DIALOG_SYMBOL_FIELDS_TABLE::OnAutoBomTimer( wxTimerEvent& aEvent )
+{
+    if( !m_autoBomFuture.valid() )
+        return;
+
+    if( m_autoBomFuture.wait_for( std::chrono::seconds( 0 ) ) != std::future_status::ready )
+    {
+        m_autoBomProgress->Pulse();
+        return;
+    }
+
+    m_autoBomTimer.Stop();
+    m_autoBomProgress->Hide();
+    m_autoBomComplete->Enable();
+    m_autoBomUseAi->Enable();
+    m_buttonExport->Enable();
+    m_grid->Enable();
+    m_variantListBox->Enable();
+
+    try
+    {
+        const std::string responseText = m_autoBomFuture.get();
+        const nlohmann::json response = nlohmann::json::parse( responseText );
+        const int failed = response.value( "failed", 0 );
+
+        m_autoBomApplying = true;
+        const int changed = m_parent->ApplyAutoBomCompletionJson( wxString::FromUTF8( responseText ) );
+        m_autoBomApplying = false;
+        const bool unresolved = failed > 0 || AutoBomCompletionNeeded();
+        m_autoBomCompleted = !unresolved;
+
+        showAutoBomExportFields();
+
+        const wxString summary = wxString::FromUTF8( response.value( "summary", std::string() ) );
+        const int completed = response.value( "completed", 0 );
+        m_autoBomStatus->SetLabel( !unresolved
+                                           ? wxString::Format( _( "%d BOM lines complete." ), completed )
+                                           : failed > 0
+                                                     ? wxString::Format(
+                                                               _( "%d complete; %d need review." ),
+                                                               completed, failed )
+                                                     : _( "Some BOM lines need review." ) );
+        m_autoBomStatus->SetToolTip( summary );
+        PreviewRefresh();
+
+        if( m_autoBomExportWhenDone )
+        {
+            if( !unresolved || ConfirmExportCurrentBom( summary ) )
+                ExportNow();
+        }
+        else if( unresolved )
+        {
+            DisplayError( this, summary + _( "\n\nReview the unresolved rows before exporting." ) );
+        }
+        else if( changed == 0 )
+            m_autoBomStatus->SetLabel( _( "All BOM part numbers were already complete." ) );
+    }
+    catch( const std::exception& error )
+    {
+        m_autoBomApplying = false;
+        m_autoBomCompleted = false;
+        const wxString message = wxString::FromUTF8( error.what() );
+        m_autoBomStatus->SetLabel( _( "Completion failed" ) );
+        m_autoBomStatus->SetToolTip( message );
+
+        if( m_autoBomExportWhenDone )
+        {
+            if( ConfirmExportCurrentBom( message ) )
+                ExportNow();
+        }
+        else
+        {
+            DisplayError( this, message );
+        }
+    }
+
+    m_autoBomExportWhenDone = false;
+    m_autoBomCancel.reset();
+    m_rightPanel->Layout();
+}
+
