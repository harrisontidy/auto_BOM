+
+void PANEL_AUTO_BOM_ASSISTANT::addCandidateCard( size_t aCandidateIndex, bool aRecommended,
+                                                  const wxString& aRecommendation,
+                                                  const wxString& aConcerns )
+{
+    const nlohmann::json candidate = nlohmann::json::parse( m_candidateJson[aCandidateIndex] );
+    const nlohmann::json assets = candidate.value( "kicadAssets", nlohmann::json::object() );
+    const bool placeable = assets.value( "placeable", false )
+                           && !jsonText( assets, "symbolId" ).IsEmpty()
+                           && !jsonText( assets, "footprintId" ).IsEmpty();
+
+    wxPanel* card = new wxPanel( m_resultsWindow, wxID_ANY, wxDefaultPosition, wxDefaultSize,
+                                 wxBORDER_SIMPLE );
+    card->SetBackgroundColour( wxSystemSettings::GetColour(
+            aRecommended ? wxSYS_COLOUR_INFOBK : wxSYS_COLOUR_LISTBOX ) );
+    card->SetForegroundColour( wxSystemSettings::GetColour( wxSYS_COLOUR_LISTBOXTEXT ) );
+
+    const int margin = FromDIP( 10 );
+    wxBoxSizer* cardSizer = new wxBoxSizer( wxVERTICAL );
+    wxBoxSizer* headingSizer = new wxBoxSizer( wxHORIZONTAL );
+
+    wxString partNumber = jsonText( candidate, "manufacturerPartNumber" );
+
+    if( partNumber.IsEmpty() )
+        partNumber = jsonText( candidate, "digiKeyPartNumber" );
+
+    wxStaticText* partNumberLabel = makeLabel( card, partNumber, true );
+    partNumberLabel->Wrap( FromDIP( 175 ) );
+    headingSizer->Add( partNumberLabel, 1, wxALIGN_CENTER_VERTICAL );
+
+    if( aRecommended )
+    {
+        wxStaticText* badge = makeLabel( card, _( "Best match" ), true );
+        badge->SetForegroundColour( wxSystemSettings::GetColour( wxSYS_COLOUR_HIGHLIGHTTEXT ) );
+        badge->SetBackgroundColour( wxSystemSettings::GetColour( wxSYS_COLOUR_HIGHLIGHT ) );
+        headingSizer->Add( badge, 0, wxALIGN_CENTER_VERTICAL | wxLEFT, FromDIP( 8 ) );
+    }
+
+    cardSizer->Add( headingSizer, 0, wxEXPAND | wxALL, margin );
+
+    wxString manufacturer = jsonText( candidate, "manufacturer" );
+    wxString digiKeyPart = jsonText( candidate, "digiKeyPartNumber" );
+    wxStaticText* identity = makeLabel( card, manufacturer + wxS( "  \u00b7  " ) + digiKeyPart );
+    identity->Wrap( FromDIP( 260 ) );
+    cardSizer->Add( identity, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, margin );
+
+    wxStaticText* description = makeLabel( card, jsonText( candidate, "description" ) );
+    description->Wrap( FromDIP( 260 ) );
+    cardSizer->Add( description, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, margin );
+
+    wxFlexGridSizer* facts = new wxFlexGridSizer( 2, FromDIP( 5 ), FromDIP( 10 ) );
+    facts->AddGrowableCol( 1, 1 );
+    addFact( facts, card, _( "Stock" ),
+             wxNumberFormatter::ToString( jsonInteger( candidate, "quantityAvailable" ), 0 ) );
+
+    wxString price = _( "Unavailable" );
+
+    if( candidate.contains( "unitPrice" ) && candidate["unitPrice"].is_number() )
+    {
+        price = wxString::Format( wxS( "%s %.4f" ), jsonText( candidate, "currency" ),
+                                  candidate["unitPrice"].get<double>() );
+    }
+
+    addFact( facts, card, _( "Unit price" ), price );
+    addFact( facts, card, _( "Packaging" ), jsonText( candidate, "packageType" ) );
+    addFact( facts, card, _( "KiCad symbol" ), jsonText( assets, "symbolId" ) );
+    addFact( facts, card, _( "Footprint" ), jsonText( assets, "footprintId" ) );
+    addFact( facts, card, _( "3D model" ),
+             assets.value( "modelExpected", false )
+                     ? _( "Available in installed KiCad library" )
+                     : _( "Not found in installed KiCad library" ) );
+    cardSizer->Add( facts, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, margin );
+
+    if( !aRecommendation.IsEmpty() )
+    {
+        wxStaticText* recommendation = makeLabel( card, _( "Why this part: " ) + aRecommendation );
+        recommendation->Wrap( FromDIP( 260 ) );
+        cardSizer->Add( recommendation, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, margin );
+    }
+
+    if( !aConcerns.IsEmpty() )
+    {
+        wxStaticText* concernsHeading = makeLabel( card, _( "Review before placing" ), true );
+        cardSizer->Add( concernsHeading, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM,
+                        margin );
+
+        wxStaticText* concerns = makeLabel( card, aConcerns );
+        concerns->Wrap( FromDIP( 260 ) );
+        cardSizer->Add( concerns, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, margin );
+    }
+
+    if( !placeable )
+    {
+        wxStaticText* unavailable = makeLabel(
+                card, _( "No safe symbol and footprint pair is available in the installed "
+                         "KiCad libraries." ) );
+        unavailable->Wrap( FromDIP( 260 ) );
+        cardSizer->Add( unavailable, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, margin );
+    }
+
+    wxBoxSizer* actionSizer = new wxBoxSizer( wxHORIZONTAL );
+    wxButton* placeButton = new wxButton( card, wxID_ANY, _( "Place in Schematic" ) );
+    placeButton->Enable( placeable && static_cast<bool>( m_placementCallback ) );
+    placeButton->Bind( wxEVT_BUTTON,
+                       [this, aCandidateIndex]( wxCommandEvent& )
+                       {
+                           placeCandidate( aCandidateIndex );
+                       } );
+    actionSizer->Add( placeButton, 1, wxEXPAND );
+
+    const wxString productUrl = jsonText( candidate, "productUrl" );
+
+    if( !productUrl.IsEmpty() )
+    {
+        wxButton* digiKeyButton = new wxButton( card, wxID_ANY, _( "DigiKey" ) );
+        digiKeyButton->Bind( wxEVT_BUTTON,
+                             [productUrl]( wxCommandEvent& )
+                             {
+                                 wxLaunchDefaultBrowser( productUrl );
+                             } );
+        actionSizer->Add( digiKeyButton, 0, wxLEFT, FromDIP( 8 ) );
+    }
+
+    cardSizer->Add( actionSizer, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, margin );
+    card->SetSizer( cardSizer );
+    m_resultsSizer->Add( card, 0, wxEXPAND | wxLEFT | wxRIGHT | wxTOP, FromDIP( 10 ) );
+}
+
+
+void PANEL_AUTO_BOM_ASSISTANT::placeCandidate( size_t aCandidateIndex )
+{
+    if( !m_placementCallback || aCandidateIndex >= m_candidateJson.size() )
+        return;
+
+    try
+    {
+        nlohmann::json candidate = nlohmann::json::parse( m_candidateJson[aCandidateIndex] );
+        const nlohmann::json component = nlohmann::json::parse( m_componentJson );
+        const nlohmann::json assets = candidate.value( "kicadAssets", nlohmann::json::object() );
+
+        candidate["command"] = "place";
+        candidate["component"] = component;
+        candidate["symbolId"] = assets.value( "symbolId", std::string() );
+        candidate["footprintId"] = assets.value( "footprintId", std::string() );
+        candidate["modelExpected"] = assets.value( "modelExpected", false );
+        candidate["value"] = assets.value( "exactSymbol", false )
+                                     ? std::string()
+                                     : component.value( "value", std::string() );
+
+        wxString placementError;
+
+        if( m_placementCallback( fromUtf8( candidate.dump() ), placementError ) )
+        {
+            setStatus( wxString::Format( _( "%s is attached to the cursor. Click the schematic "
+                                            "to place it." ),
+                                         jsonText( candidate, "manufacturerPartNumber" ) ) );
+        }
+        else
+        {
+            setStatus( placementError.IsEmpty() ? _( "KiCad could not place this result." )
+                                                : placementError,
+                       true );
+        }
+    }
+    catch( const std::exception& error )
+    {
+        setStatus( wxString::Format( _( "Could not prepare this part for placement: %s" ),
+                                     fromUtf8( error.what() ) ), true );
+    }
+}
+
+
+void PANEL_AUTO_BOM_ASSISTANT::setBusy( bool aBusy )
+{
+    m_queryCtrl->Enable( !aBusy );
+    m_searchButton->Enable( !aBusy );
+
+    if( aBusy )
+    {
+        m_activity->Show();
+        m_activity->Start();
+        m_searchButton->SetLabel( _( "Searching..." ) );
+    }
+    else
+    {
+        m_activity->Stop();
+        m_activity->Hide();
+        m_searchButton->SetLabel( _( "Find Parts" ) );
+    }
+
+    Layout();
+}
+
+
+void PANEL_AUTO_BOM_ASSISTANT::setStatus( const wxString& aMessage, bool aError )
+{
+    m_statusLabel->SetLabel( aMessage );
+    m_statusLabel->SetForegroundColour( wxSystemSettings::GetColour(
+            aError ? wxSYS_COLOUR_HOTLIGHT : wxSYS_COLOUR_WINDOWTEXT ) );
+    m_statusLabel->Wrap( FromDIP( 290 ) );
+    Layout();
+}
