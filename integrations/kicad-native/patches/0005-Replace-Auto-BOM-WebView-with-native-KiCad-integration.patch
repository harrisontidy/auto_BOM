+static std::string postAutoBomRequest( const std::string& aRequest,
+                                       const std::shared_ptr<std::atomic_bool>& aCancel )
+{
+    KICAD_CURL_EASY curl;
+    curl.SetUserAgent( "KiCad-AutoBOM/1.0" );
+    curl.SetHeader( "Content-Type", "application/json" );
+    curl.SetConnectTimeout( 3 );
+    curl.SetTimeout( 180 );
+    curl.SetTransferCallback(
+            [aCancel]( size_t, size_t, size_t, size_t ) -> int
+            {
+                return aCancel && aCancel->load() ? 1 : 0;
+            },
+            0 );
+
+    if( !curl.SetURL( "http://127.0.0.1:4173/api/bom/complete" )
+        || !curl.SetPostFields( aRequest ) )
+        throw std::runtime_error( "Could not prepare the Auto BOM request." );
+
+    const int result = curl.Perform();
+    if( result != CURLE_OK )
+        throw std::runtime_error( "Auto BOM service is unavailable: " + curl.GetErrorText( result ) );
+
+    const std::string response = curl.GetBuffer();
+    const int status = curl.GetResponseStatusCode();
+    nlohmann::json parsed;
+
+    try
+    {
+        parsed = nlohmann::json::parse( response );
+    }
+    catch( const std::exception& )
+    {
+        throw std::runtime_error( "Auto BOM returned an unreadable response." );
+    }
+
+    if( status < 200 || status >= 300 )
+    {
+        const std::string detail = parsed.contains( "error" ) && parsed["error"].is_string()
+                                       ? parsed["error"].get<std::string>()
+                                       : "The request failed.";
+        throw std::runtime_error( detail );
+    }
+
+    return response;
+}
