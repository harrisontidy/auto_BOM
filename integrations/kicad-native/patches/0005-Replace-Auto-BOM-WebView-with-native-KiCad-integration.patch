+
+void addFact( wxFlexGridSizer* aSizer, wxWindow* aParent, const wxString& aName,
+              const wxString& aValue )
+{
+    wxStaticText* name = makeLabel( aParent, aName, true );
+    wxStaticText* value = makeLabel( aParent, aValue.IsEmpty() ? wxS( "\u2014" ) : aValue );
+    value->Wrap( aParent->FromDIP( 170 ) );
+    aSizer->Add( name, 0, wxALIGN_TOP );
+    aSizer->Add( value, 1, wxEXPAND );
+}
