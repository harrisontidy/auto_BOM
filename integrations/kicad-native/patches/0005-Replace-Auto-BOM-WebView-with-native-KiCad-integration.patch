+
+wxStaticText* makeLabel( wxWindow* aParent, const wxString& aText, bool aBold = false )
+{
+    wxStaticText* label = new wxStaticText( aParent, wxID_ANY, aText );
+
+    if( aBold )
+    {
+        wxFont font = label->GetFont();
+        font.MakeBold();
+        label->SetFont( font );
+    }
+
+    return label;
+}
