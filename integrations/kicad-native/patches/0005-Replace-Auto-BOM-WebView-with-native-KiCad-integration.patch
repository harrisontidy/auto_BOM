 void DIALOG_SYMBOL_FIELDS_TABLE::OnExport( wxCommandEvent& aEvent )
+{
+    if( m_autoBomComplete && !m_autoBomCompleted && AutoBomCompletionNeeded() )
+    {
+        StartAutoBomCompletion( true );
+        return;
+    }
+
+    ExportNow();
+}
