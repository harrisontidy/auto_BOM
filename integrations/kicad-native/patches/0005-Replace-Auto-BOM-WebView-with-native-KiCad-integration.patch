+
+void PANEL_AUTO_BOM_ASSISTANT::beginSearch( const wxString& aQuery )
+{
+    wxString query = aQuery;
+    query.Trim( true ).Trim( false );
+
+    if( query.IsEmpty() )
+    {
+        setStatus( _( "Describe a component before searching." ), true );
+        FocusSearch();
+        return;
+    }
+
+    if( m_searchThread.joinable() )
+    {
+        m_searchThread.request_stop();
+        m_searchThread.join();
+    }
+
+    clearResults();
+    setBusy( true );
+    setStatus( _( "Understanding your request and checking DigiKey stock..." ) );
+
+    nlohmann::json request = { { "query", toUtf8( query ) } };
+    const uint64_t generation = ++m_searchGeneration;
+    m_searchThread = std::jthread(
+            [this, generation, requestBody = request.dump()]( std::stop_token aStopToken )
+            {
+                runSearch( aStopToken, generation, requestBody );
+            } );
+}
+
+
+void PANEL_AUTO_BOM_ASSISTANT::runSearch( std::stop_token aStopToken, uint64_t aGeneration,
+                                          std::string aRequestBody )
+{
+    nlohmann::json result = {
+        { "generation", aGeneration },
+        { "transportCode", 0 },
+        { "httpStatus", 0 },
+        { "body", "" },
+        { "error", "" }
+    };
+
+    try
+    {
+        KICAD_CURL_EASY request;
+        request.SetURL( "http://127.0.0.1:4173/api/components/search" );
+        request.SetHeader( "Accept", "application/json" );
+        request.SetHeader( "Content-Type", "application/json" );
+        request.SetConnectTimeout( 5 );
+        request.SetTimeout( 90 );
+        request.SetPostFields( aRequestBody );
+        request.SetTransferCallback(
+                [aStopToken]( size_t, size_t, size_t, size_t ) -> int
+                {
+                    return aStopToken.stop_requested() ? 1 : 0;
+                },
+                0 );
+
+        const int transportCode = request.Perform();
+
+        if( aStopToken.stop_requested() )
+            return;
+
+        result["transportCode"] = transportCode;
+        result["httpStatus"] = request.GetResponseStatusCode();
+        result["body"] = request.GetBuffer();
+
+        if( transportCode != 0 )
+            result["error"] = request.GetErrorText( transportCode );
+    }
+    catch( const std::exception& error )
+    {
+        if( aStopToken.stop_requested() )
+            return;
+
+        result["error"] = error.what();
+    }
+
+    if( aStopToken.stop_requested() )
+        return;
+
+    wxThreadEvent* event = new wxThreadEvent( wxEVT_THREAD, ID_AUTO_BOM_SEARCH_RESULT );
+    event->SetString( fromUtf8( result.dump() ) );
+    wxQueueEvent( this, event );
+}
+
+
+void PANEL_AUTO_BOM_ASSISTANT::onSearchComplete( wxThreadEvent& aEvent )
+{
+    const nlohmann::json result = nlohmann::json::parse( toUtf8( aEvent.GetString() ),
+                                                         nullptr, false );
+
+    if( result.is_discarded() || !result.is_object() )
+    {
+        setBusy( false );
+        setStatus( _( "The component service returned an unreadable response." ), true );
+        return;
+    }
+
+    const uint64_t generation = result.value( "generation", uint64_t( 0 ) );
+
+    if( generation != m_searchGeneration.load() )
+        return;
+
+    setBusy( false );
+
+    const int transportCode = result.value( "transportCode", 0 );
+    const int httpStatus = result.value( "httpStatus", 0 );
+    const std::string error = result.value( "error", std::string() );
+    const std::string body = result.value( "body", std::string() );
+
+    if( transportCode != 0 )
+    {
+        setStatus( wxString::Format( _( "Could not reach the component service: %s" ),
+                                     fromUtf8( error ) ), true );
+        return;
+    }
+
+    if( httpStatus < 200 || httpStatus >= 300 )
+    {
+        const nlohmann::json errorResponse = nlohmann::json::parse( body, nullptr, false );
+        wxString detail = jsonText( errorResponse, "error" );
+
+        if( detail.IsEmpty() )
+            detail = wxString::Format( _( "HTTP error %d" ), httpStatus );
+
+        setStatus( detail, true );
+        return;
+    }
+
+    renderResponse( body );
+}
+
+
+void PANEL_AUTO_BOM_ASSISTANT::clearResults()
+{
+    m_componentJson.clear();
+    m_candidateJson.clear();
+    m_resultsSizer->Clear( true );
+    m_resultHeading->Hide();
+    m_resultsWindow->FitInside();
+    Layout();
+}
+
+
+void PANEL_AUTO_BOM_ASSISTANT::renderResponse( const std::string& aResponseBody )
+{
+    const nlohmann::json response = nlohmann::json::parse( aResponseBody, nullptr, false );
+
+    if( response.is_discarded() || !response.is_object() )
+    {
+        setStatus( _( "The component service returned invalid data." ), true );
+        return;
+    }
+
+    const nlohmann::json component = response.value( "component", nlohmann::json::object() );
+    const nlohmann::json review = response.value( "review", nlohmann::json::object() );
+    nlohmann::json candidates = response.value( "candidates", nlohmann::json::array() );
+
+    if( !candidates.is_array() )
+        candidates = nlohmann::json::array();
+
+    m_componentJson = component.dump();
+    const wxString selectedDigiKey = jsonText( review, "selectedDigiKeyPartNumber" );
+    const wxString selectedManufacturer = jsonText( review, "selectedManufacturerPartNumber" );
+
+    std::stable_sort( candidates.begin(), candidates.end(),
+                      [&]( const nlohmann::json& aLeft, const nlohmann::json& aRight )
+                      {
+                          const bool leftRecommended =
+                                  ( !selectedDigiKey.IsEmpty()
+                                    && jsonText( aLeft, "digiKeyPartNumber" ) == selectedDigiKey )
+                                  || ( !selectedManufacturer.IsEmpty()
+                                       && jsonText( aLeft, "manufacturerPartNumber" )
+                                                  == selectedManufacturer );
+                          const bool rightRecommended =
+                                  ( !selectedDigiKey.IsEmpty()
+                                    && jsonText( aRight, "digiKeyPartNumber" ) == selectedDigiKey )
+                                  || ( !selectedManufacturer.IsEmpty()
+                                       && jsonText( aRight, "manufacturerPartNumber" )
+                                                  == selectedManufacturer );
+                          return leftRecommended && !rightRecommended;
+                      } );
+
+    for( const nlohmann::json& candidate : candidates )
+        m_candidateJson.emplace_back( candidate.dump() );
+
+    const wxString summary = jsonText( component, "summary" );
+    m_resultHeading->SetLabel( summary.IsEmpty() ? _( "Suggestions" ) : summary );
+    m_resultHeading->Wrap( FromDIP( 300 ) );
+    m_resultHeading->Show();
+
+    if( m_candidateJson.empty() )
+    {
+        wxStaticText* empty = makeLabel(
+                m_resultsWindow,
+                _( "No in-stock match was found. Try fewer restrictions or include a package "
+                   "name." ) );
+        empty->Wrap( FromDIP( 280 ) );
+        m_resultsSizer->Add( empty, 0, wxEXPAND | wxALL, FromDIP( 12 ) );
+        setStatus( _( "No matching in-stock parts found." ), true );
+    }
+    else
+    {
+        const wxString recommendation = jsonText( review, "reasoning" );
+        const wxString concerns = reviewConcerns( review );
+
+        for( size_t i = 0; i < m_candidateJson.size(); ++i )
+        {
+            const nlohmann::json candidate = nlohmann::json::parse( m_candidateJson[i] );
+            const bool recommended =
+                    ( !selectedDigiKey.IsEmpty()
+                      && jsonText( candidate, "digiKeyPartNumber" ) == selectedDigiKey )
+                    || ( !selectedManufacturer.IsEmpty()
+                         && jsonText( candidate, "manufacturerPartNumber" )
+                                    == selectedManufacturer );
+            addCandidateCard( i, recommended, recommended ? recommendation : wxString(),
+                              recommended ? concerns : wxString() );
+        }
+
+        wxString status = wxString::Format(
+                m_candidateJson.size() == 1
+                        ? _( "Found %zu in-stock option." )
+                        : _( "Found %zu in-stock options. Best match is first." ),
+                m_candidateJson.size() );
+
+        if( !concerns.IsEmpty() )
+            status += _( " Review the note on the best match before placing it." );
+
+        setStatus( status, !concerns.IsEmpty() );
+    }
+
+    m_resultsWindow->Layout();
+    m_resultsWindow->FitInside();
+    m_resultsWindow->Scroll( 0, 0 );
+    Layout();
+}
