+#ifndef PANEL_AUTO_BOM_ASSISTANT_H
+#define PANEL_AUTO_BOM_ASSISTANT_H
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <wx/panel.h>
+#include <wx/string.h>
+
+
+class wxActivityIndicator;
+class wxBoxSizer;
+class wxButton;
+class wxScrolledWindow;
+class wxStaticText;
+class wxTextCtrl;
+class wxThreadEvent;
+
+
+/**
+ * Native KiCad component finder backed by the local Auto BOM service.
+ *
+ * The service interprets a natural-language request and returns current
+ * DigiKey candidates with resolved KiCad library assets.  This panel owns
+ * presentation and network activity; the schematic editor supplies the
+ * callback that turns a selected candidate into an interactive placement.
+ */
+class PANEL_AUTO_BOM_ASSISTANT : public wxPanel
+{
+public:
+    using PLACEMENT_CALLBACK = std::function<bool( const wxString&, wxString& )>;
+
+    PANEL_AUTO_BOM_ASSISTANT( wxWindow* aParent, PLACEMENT_CALLBACK aPlacementCallback );
+    ~PANEL_AUTO_BOM_ASSISTANT() override;
+
+    /** Put keyboard focus in the request field. */
+    void FocusSearch();
+
+    /** Populate the request field and immediately run a search. */
+    void StartSearch( const wxString& aQuery );
+
+private:
+    void onSearch( wxCommandEvent& aEvent );
+    void onSearchComplete( wxThreadEvent& aEvent );
+    void beginSearch( const wxString& aQuery );
+    void runSearch( std::stop_token aStopToken, uint64_t aGeneration, std::string aRequestBody );
+
+    void clearResults();
+    void renderResponse( const std::string& aResponseBody );
+    void addCandidateCard( size_t aCandidateIndex, bool aRecommended,
+                           const wxString& aRecommendation, const wxString& aConcerns );
+    void placeCandidate( size_t aCandidateIndex );
+    void setBusy( bool aBusy );
+    void setStatus( const wxString& aMessage, bool aError = false );
+
+private:
+    PLACEMENT_CALLBACK        m_placementCallback;
+    wxTextCtrl*               m_queryCtrl;
+    wxButton*                 m_searchButton;
+    wxActivityIndicator*      m_activity;
+    wxStaticText*             m_statusLabel;
+    wxStaticText*             m_resultHeading;
+    wxScrolledWindow*         m_resultsWindow;
+    wxBoxSizer*               m_resultsSizer;
+    std::jthread              m_searchThread;
+    std::atomic<uint64_t>     m_searchGeneration;
+    std::string               m_componentJson;
+    std::vector<std::string>  m_candidateJson;
+
+    wxDECLARE_NO_COPY_CLASS( PANEL_AUTO_BOM_ASSISTANT );
+};
+
+#endif // PANEL_AUTO_BOM_ASSISTANT_H
