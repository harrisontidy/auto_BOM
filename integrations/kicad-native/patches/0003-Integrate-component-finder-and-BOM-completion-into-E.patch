+void SCH_EDIT_FRAME::SendAutoBomSchematic( WEBVIEW_PANEL* aPanel )
+{
+    if( !aPanel )
+        return;
+
+    SCH_REFERENCE_LIST references;
+    Schematic().Hierarchy().GetSymbols( references, SYMBOL_FILTER_NON_POWER, false );
+    nlohmann::json symbols = nlohmann::json::array();
+
+    for( size_t i = 0; i < references.GetCount(); ++i )
+    {
+        SCH_REFERENCE& reference = references[i];
+        SCH_SYMBOL* symbol = reference.GetSymbol();
+
+        if( !symbol || reference.GetSymbolExcludedFromBOM() || reference.GetSheetPath().GetExcludedFromBOM() )
+            continue;
+
+        symbols.push_back( {
+            { "reference", jsonUtf8( reference.GetFullRef( false ) ) },
+            { "value", jsonUtf8( symbol->GetValue( true, &reference.GetSheetPath(), false ) ) },
+            { "footprint", jsonUtf8( symbol->GetFootprintFieldText( true, &reference.GetSheetPath(), false ) ) },
+            { "symbolId", jsonUtf8( UnescapeString( symbol->GetLibId().Format() ) ) },
+            { "manufacturerPartNumber", jsonUtf8( autoBomFirstFieldText(
+                    symbol, { wxS( "Manufacturer Part Number" ), wxS( "MPN" ),
+                              wxS( "MFR Part Number" ) } ) ) },
+            { "digiKeyPartNumber", jsonUtf8( autoBomFirstFieldText(
+                    symbol, { wxS( "DigiKey Part Number" ), wxS( "Digi-Key Part Number" ),
+                              wxS( "Digi-Key_PN" ), wxS( "DigiKey" ) } ) ) },
+            { "datasheetUrl", jsonUtf8( autoBomFieldText( symbol, wxS( "Datasheet" ) ) ) }
+        } );
+    }
+
+    nlohmann::json detail = { { "symbols", std::move( symbols ) } };
+    const wxString script = wxS( "window.dispatchEvent(new CustomEvent('autobom-schematic',{detail:" )
+                            + wxString::FromUTF8( detail.dump() ) + wxS( "}));" );
+    aPanel->RunScriptAsync( script );
+}
+
+
+void SCH_EDIT_FRAME::HandleAutoBomMessage( WEBVIEW_PANEL* aPanel, const wxString& aPayload )
+{
+    try
+    {
+        const nlohmann::json message = nlohmann::json::parse( aPayload.ToStdString() );
+        const wxString command = jsonString( message, "command" );
+
+        if( command == wxS( "ping" ) )
+        {
+            aPanel->RunScriptAsync(
+                    wxS( "window.dispatchEvent(new CustomEvent('autobom-native',{detail:{connected:true}}));" ) );
+            return;
+        }
+
+        if( command == wxS( "openUrl" ) )
+        {
+            const wxString url = jsonString( message, "url" );
+
+            if( url.StartsWith( wxS( "https://" ) ) || url.StartsWith( wxS( "http://" ) ) )
+                wxLaunchDefaultBrowser( url );
+
+            return;
+        }
+
+        if( command == wxS( "getSchematic" ) )
+        {
+            SendAutoBomSchematic( aPanel );
+            return;
+        }
+
+        if( command == wxS( "updateBomFields" ) )
+        {
+            if( !message.contains( "references" ) || !message["references"].is_array() )
+                return;
+
+            std::unordered_set<std::string> requestedReferences;
+
+            for( const nlohmann::json& reference : message["references"] )
+            {
+                if( reference.is_string() )
+                    requestedReferences.insert( reference.get<std::string>() );
+            }
+
+            SCH_REFERENCE_LIST references;
+            Schematic().Hierarchy().GetSymbols( references, SYMBOL_FILTER_NON_POWER, false );
+            SCH_COMMIT commit( this );
+            std::unordered_set<SCH_SYMBOL*> modified;
+
+            for( size_t i = 0; i < references.GetCount(); ++i )
+            {
+                SCH_REFERENCE& reference = references[i];
+                SCH_SYMBOL* symbol = reference.GetSymbol();
+
+                if( !symbol || !requestedReferences.contains( jsonUtf8( reference.GetFullRef( false ) ) ) )
+                    continue;
+
+                if( modified.insert( symbol ).second )
+                    commit.Modify( symbol, reference.GetSheetPath().LastScreen() );
+
+                setAutoBomField( symbol, wxS( "Manufacturer Part Number" ),
+                                 jsonString( message, "manufacturerPartNumber" ) );
+                setAutoBomField( symbol, wxS( "DigiKey Part Number" ),
+                                 jsonString( message, "digiKeyPartNumber" ) );
+                setAutoBomField( symbol, wxS( "Datasheet" ), jsonString( message, "datasheetUrl" ) );
+
+                const wxString footprint = jsonString( message, "footprintId" );
+
+                if( symbol->GetFootprintFieldText( true, &reference.GetSheetPath(), false ).IsEmpty()
+                    && !footprint.IsEmpty() )
+                    symbol->SetFootprintFieldText( footprint );
+            }
+
+            if( !modified.empty() )
+            {
+                commit.Push( _( "Complete BOM fields" ) );
+                OnModify();
+            }
+
+            return;
+        }
+    }
+    catch( const std::exception& error )
+    {
+        wxLogError( "Auto BOM message failed: %s", error.what() );
+        return;
+    }
+
+    placeAutoBomSymbol( this, aPayload );
+}
