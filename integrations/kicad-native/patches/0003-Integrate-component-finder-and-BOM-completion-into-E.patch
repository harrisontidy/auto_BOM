+void SCH_EDIT_FRAME::ShowAutoBomManager()
+{
+    if( !m_autoBomManagerFrame )
+    {
+        m_autoBomManagerFrame = new wxFrame( this, wxID_ANY, _( "Complete BOM with DigiKey" ),
+                                             wxDefaultPosition, FromDIP( wxSize( 1180, 760 ) ),
+                                             wxDEFAULT_FRAME_STYLE | wxFRAME_FLOAT_ON_PARENT );
+        m_autoBomManagerFrame->SetMinSize( FromDIP( wxSize( 760, 520 ) ) );
+        m_autoBomManagerPanel = new WEBVIEW_PANEL( m_autoBomManagerFrame );
+        m_autoBomManagerPanel->AddMessageHandler( wxS( "autobom" ),
+                                                  [this]( const wxString& aPayload )
+                                                  {
+                                                      HandleAutoBomMessage( m_autoBomManagerPanel,
+                                                                            aPayload );
+                                                  } );
+        m_autoBomManagerPanel->SetHandleExternalLinks( true );
+        m_autoBomManagerPanel->BindLoadedEvent();
+        m_autoBomManagerPanel->LoadURL(
+                wxS( "http://127.0.0.1:4173/?embedded=kicad&view=bom" ) );
+
+        wxBoxSizer* sizer = new wxBoxSizer( wxVERTICAL );
+        sizer->Add( m_autoBomManagerPanel, 1, wxEXPAND );
+        m_autoBomManagerFrame->SetSizer( sizer );
+        m_autoBomManagerFrame->Bind( wxEVT_CLOSE_WINDOW,
+                                     [this]( wxCloseEvent& aEvent )
+                                     {
+                                         if( aEvent.CanVeto() )
+                                         {
+                                             m_autoBomManagerFrame->Hide();
+                                             aEvent.Veto();
+                                         }
+                                         else
+                                         {
+                                             aEvent.Skip();
+                                         }
+                                     } );
+    }
+    else
+    {
+        m_autoBomManagerPanel->LoadURL(
+                wxS( "http://127.0.0.1:4173/?embedded=kicad&view=bom" ) );
+    }
+
+    m_autoBomManagerFrame->Show();
+    m_autoBomManagerFrame->Raise();
+}
