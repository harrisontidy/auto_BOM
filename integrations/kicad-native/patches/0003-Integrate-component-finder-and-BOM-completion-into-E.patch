+static wxString autoBomFieldText( const SCH_SYMBOL* aSymbol, const wxString& aName )
+{
+    if( const SCH_FIELD* field = aSymbol->GetField( aName ) )
+        return field->GetText();
+
+    return wxString();
+}
+
+
+static wxString autoBomFirstFieldText( const SCH_SYMBOL* aSymbol,
+                                       std::initializer_list<wxString> aNames )
+{
+    for( const wxString& name : aNames )
+    {
+        const wxString text = autoBomFieldText( aSymbol, name );
+
+        if( !text.IsEmpty() )
+            return text;
+    }
+
+    return wxString();
+}
+
+
+static void setAutoBomField( SCH_SYMBOL* aSymbol, const wxString& aName, const wxString& aValue )
+{
+    if( aValue.IsEmpty() )
+        return;
+
+    SCH_FIELD* field = aSymbol->GetField( aName );
+
+    if( !field )
+        field = aSymbol->AddField( SCH_FIELD( aSymbol, FIELD_T::USER, aName ) );
+
+    field->SetText( aValue );
+}
