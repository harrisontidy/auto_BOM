+void SCH_EDIT_FRAME::ToggleAutoBomPanel()
+{
+    wxAuiPaneInfo& pane = m_auimgr.GetPane( AutoBomPaneName() );
+    pane.Show( !pane.IsShown() );
+
+    if( pane.IsShown() )
+    {
+        if( pane.IsDocked() )
+            SetAuiPaneSize( m_auimgr, pane, FromDIP( 440 ), -1 );
+        else
+            m_auimgr.Update();
+
+        m_autoBomPanel->LoadURL( wxS( "http://127.0.0.1:4173/?embedded=kicad" ) );
+    }
+    else
+    {
+        m_auimgr.Update();
+    }
+}
