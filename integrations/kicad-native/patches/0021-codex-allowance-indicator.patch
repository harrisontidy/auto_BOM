+void PANEL_AUTO_BOM_ASSISTANT::loadUsage()
+{
+    if( m_usageLoading || m_providerCtrl->GetSelection() != 0 ) return;
+    m_usageLoading = true;
+    if( m_usageThread.joinable() ) m_usageThread.join();
+    m_usageThread = std::jthread( [this]( std::stop_token stop ) {
+        nlohmann::json data;
+        try {
+            KICAD_CURL_EASY request;
+            request.SetURL( "http://127.0.0.1:4173/api/ask/usage" );
+            request.SetConnectTimeout( 3 ); request.SetTimeout( 15 );
+            request.SetTransferCallback( [stop]( size_t,size_t,size_t,size_t ) { return stop.stop_requested() ? 1 : 0; }, 0 );
+            if( request.Perform() != 0 ) throw std::runtime_error( "Allowance unavailable; retrying automatically." );
+            data = nlohmann::json::parse( request.GetBuffer() );
+        } catch( const std::exception& error ) { data = { { "error", error.what() } }; }
+        if( stop.stop_requested() ) return;
+        auto* event = new wxThreadEvent( wxEVT_THREAD, ID_AUTO_BOM_USAGE );
+        event->SetString( fromUtf8( data.dump() ) );
+        wxQueueEvent( this, event );
+    } );
+}
