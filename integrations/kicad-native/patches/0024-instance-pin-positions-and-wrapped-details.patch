+// Native Wrap() does not split long identifiers, so footprint names can force
+// the entire card wider than the sidebar.
+class AUTO_BOM_FACT_TEXT : public wxStaticText
+{
+public:
+    AUTO_BOM_FACT_TEXT( wxWindow* parent, const wxString& text ) :
+            wxStaticText( parent, wxID_ANY, wxEmptyString, wxDefaultPosition,
+                          wxDefaultSize, wxST_NO_AUTORESIZE ), m_text( text )
+    {
+        SetToolTip( text );
+        Rewrap( FromDIP( 170 ) );
+        Bind( wxEVT_SIZE, [this]( wxSizeEvent& event ) {
+            Rewrap( event.GetSize().x );
+            event.Skip();
+        } );
+    }
+
+private:
+    void Rewrap( int width )
+    {
+        if( width < 1 || width == m_width )
+            return;
+        m_width = width;
+        wxString result, line;
+        for( const auto ch : m_text )
+        {
+            if( ch == '\n' )
+            {
+                result += line + wxS( "\n" );
+                line.clear();
+                continue;
+            }
+            wxString next = line + ch;
+            if( !line.IsEmpty() && GetTextExtent( next ).x > width )
+            {
+                const int space = line.Find( ' ', true );
+                if( space > 0 )
+                {
+                    result += line.Left( space ) + wxS( "\n" );
+                    line = line.Mid( space + 1 );
+                }
+                else
+                {
+                    result += line + wxS( "\n" );
+                    line.clear();
+                }
+            }
+            line += ch;
+        }
+        SetLabelText( result + line );
+        SetMinSize( wxSize( 1, GetBestSize().y ) );
+        if( GetParent()->GetSizer() )
+            GetParent()->Layout();
+    }
+
+    wxString m_text;
+    int m_width = -1;
+};
