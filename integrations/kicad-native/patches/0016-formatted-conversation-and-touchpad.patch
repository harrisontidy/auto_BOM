+
+bool PANEL_AUTO_BOM_ASSISTANT::isFollowingConversation() const
+{
+    int x = 0, y = 0;
+    m_resultsWindow->GetViewStart( &x, &y );
+    return y + m_resultsWindow->GetClientSize().y >= m_resultsWindow->GetVirtualSize().y - FromDIP( 30 );
+}
+
+void PANEL_AUTO_BOM_ASSISTANT::bindConversationWheel( wxWindow* aWindow )
+{
+    aWindow->Bind( wxEVT_MOUSEWHEEL, [this]( wxMouseEvent& event ) {
+        if( event.GetWheelAxis() != wxMOUSE_WHEEL_VERTICAL || !event.GetWheelDelta() ) {
+            event.Skip(); return;
+        }
+        const double distance = event.IsPageScroll() ? m_resultsWindow->GetClientSize().y
+                : std::max( 1, event.GetLinesPerAction() ) * FromDIP( 18 );
+        m_wheelRemainder -= double( event.GetWheelRotation() ) / event.GetWheelDelta() * distance;
+        const int pixels = static_cast<int>( m_wheelRemainder );
+        m_wheelRemainder -= pixels;
+        int x = 0, y = 0;
+        m_resultsWindow->GetViewStart( &x, &y );
+        m_resultsWindow->Scroll( x, std::max( 0, y + pixels ) );
+        // Do not let the non-scrolling HTML child consume or repeat the gesture.
+    } );
+    for( wxWindow* child : aWindow->GetChildren() ) bindConversationWheel( child );
 }
 
