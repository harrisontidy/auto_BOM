+// Model content is text, never a source of embedded browser resources.
+class ASSISTANT_HTML_WINDOW : public wxHtmlWindow
+{
+public:
+    explicit ASSISTANT_HTML_WINDOW( wxWindow* aParent ) :
+            wxHtmlWindow( aParent, wxID_ANY, wxDefaultPosition, wxDefaultSize,
+                          wxHW_SCROLLBAR_NEVER | wxBORDER_NONE ) {}
+
+    wxHtmlOpeningStatus OnOpeningURL( wxHtmlURLType, const wxString&, wxString* ) const override
