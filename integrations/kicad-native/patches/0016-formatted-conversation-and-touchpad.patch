+        return wxHTML_BLOCK;
+    }
+};
+
+wxString formatAssistantText( wxString aText )
+{
+    // Escape raw HTML before Markdown conversion; only renderer-created markup is allowed.
+    aText.Replace( wxS( "&" ), wxS( "&amp;" ) );
+    aText.Replace( wxS( "<" ), wxS( "&lt;" ) );
+    aText.Replace( wxS( ">" ), wxS( "&gt;" ) );
+    wxString html;
+    ConvertMarkdown2Html( aText, html );
+    for( const auto* tag : { "h1", "h2" } ) {
+        html.Replace( wxS( "<" ) + wxString( tag ) + wxS( ">" ), wxS( "<h3>" ) );
+        html.Replace( wxS( "</" ) + wxString( tag ) + wxS( ">" ), wxS( "</h3>" ) );
+    }
+    return html;
+}
 
