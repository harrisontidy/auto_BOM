+void PANEL_AUTO_BOM_ASSISTANT::renderConversation()
+{
+    auto escape = []( wxString text ) {
+        text.Replace( wxS( "&" ), wxS( "&amp;" ) ); text.Replace( wxS( "<" ), wxS( "&lt;" ) );
+        text.Replace( wxS( ">" ), wxS( "&gt;" ) ); text.Replace( wxS( "\n" ), wxS( "<br>" ) );
+        return text;
+    };
+    const auto history = nlohmann::json::parse( m_historyJson );
+    const wxString background = GetBackgroundColour().GetAsString( wxC2S_HTML_SYNTAX );
+    const wxString foreground = GetForegroundColour().GetAsString( wxC2S_HTML_SYNTAX );
+    wxString html = wxS( "<html><body bgcolor='" ) + background + wxS( "' text='" ) + foreground + wxS( "'>" );
+    if( history.empty() )
+        html += _( "<h3>What are you designing?</h3><p>Describe a part, compare options, or work through a circuit question.</p><p>Try: <i>Find an easy-to-solder MCU with Wi-Fi and Bluetooth.</i></p><p>Parts appear here when a search is useful. Review a result, then place it in your schematic.</p>" );
+    for( const auto& message : history )
+    {
+        wxString content = jsonText( message, "content" );
+        const int context = content.Find( wxS( "\nSearch context:" ) );
+        if( context != wxNOT_FOUND ) content = content.Left( context );
+        html += wxS( "<p><b>" ) + ( message.value( "role", std::string() ) == "user" ? _( "You" ) : _( "Assistant" ) )
+             + wxS( "</b><br>" ) + escape( content ) + wxS( "</p><hr>" );
+    }
+    if( m_busy && !m_pendingQuestion.empty() )
+        html += wxS( "<p><b>" ) + _( "You" ) + wxS( "</b><br>" ) + escape( fromUtf8( m_pendingQuestion ) )
+             + wxS( "</p><p><i>" ) + _( "Working on your request..." ) + wxS( "</i></p>" );
+    html += wxS( "</body></html>" );
+    m_chatCtrl->SetPage( html );
+    m_chatCtrl->Scroll( 0, m_chatCtrl->GetScrollRange( wxVERTICAL ) );
+}
+
+void PANEL_AUTO_BOM_ASSISTANT::updateEfforts()
+{
+    m_effortCtrl->Clear(); m_effortCtrl->Append( _( "Auto reasoning" ) ); m_effortIds = { "auto" };
+    const auto data = nlohmann::json::parse( m_modelsJson, nullptr, false );
+    if( data.is_object() && data.contains( "models" ) )
+    {
+        std::string id = m_modelIds.at( m_modelCtrl->GetSelection() );
+        if( id == "latest" ) id = data.value( "latest", std::string() );
+        for( const auto& model : data["models"] ) if( model.value( "id", std::string() ) == id )
+        {
+            m_effortCtrl->SetString( 0, _( "Auto: " ) + jsonText( model, "defaultEffort" ) );
+            for( const auto& level : model["efforts"] ) {
+                const auto value = level.get<std::string>(); m_effortIds.push_back( value );
+                const wxString label = value == "low" ? _( "Low - faster" ) : value == "medium" ? _( "Medium" )
+                    : value == "high" ? _( "High" ) : value == "xhigh" ? _( "Extra high" )
+                    : value == "max" ? _( "Maximum" ) : fromUtf8( value );
+                m_effortCtrl->Append( label );
+            }
+        }
+    }
+    m_effortCtrl->SetSelection( 0 );
+}
+
+void PANEL_AUTO_BOM_ASSISTANT::loadModels()
+{
+    if( m_modelThread.joinable() ) { m_modelThread.request_stop(); m_modelThread.join(); }
+    const auto generation = ++m_modelGeneration;
+    const std::string provider = m_providerCtrl->GetSelection() == 0 ? "codex" : "api";
+    m_modelsJson.clear(); m_modelCtrl->Clear(); m_modelCtrl->Append( _( "Latest available" ) );
+    m_modelCtrl->SetSelection( 0 ); m_modelIds = { "latest" }; updateEfforts();
+    m_modelThread = std::jthread( [this,generation,provider]( std::stop_token stop ) {
+        nlohmann::json data;
+        try {
+            KICAD_CURL_EASY request;
+            request.SetURL( "http://127.0.0.1:4173/api/ask/models?provider=" + provider );
+            request.SetConnectTimeout( 3 ); request.SetTimeout( 20 );
+            request.SetTransferCallback( [stop]( size_t,size_t,size_t,size_t ) { return stop.stop_requested() ? 1 : 0; }, 0 );
+            if( request.Perform() != 0 ) throw std::runtime_error( "Model list unavailable. Check the local service." );
+            data = nlohmann::json::parse( request.GetBuffer() );
+        } catch( const std::exception& error ) { data = { { "error", error.what() } }; }
+        if( stop.stop_requested() ) return;
+        auto* event = new wxThreadEvent( wxEVT_THREAD, ID_AUTO_BOM_MODELS );
+        event->SetString( fromUtf8( nlohmann::json( { { "generation", generation }, { "data", data } } ).dump() ) );
+        wxQueueEvent( this, event );
+    } );
+}
