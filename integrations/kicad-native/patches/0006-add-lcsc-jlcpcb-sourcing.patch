+static bool registerAutoBomAssets( const nlohmann::json& aAssets, wxString& aError )
+{
+    if( !aAssets.is_object() || !aAssets.value( "imported", false ) )
+        return true;
+
+    const wxString nickname = jsonString( aAssets, "libraryName" );
+    const wxString symbolPath = jsonString( aAssets, "symbolLibraryPath" );
+    const wxString footprintPath = jsonString( aAssets, "footprintLibraryPath" );
+    const wxString id = nickname.Mid( 9 );
+    if( !nickname.StartsWith( wxS( "AutoBOM_C" ) ) || id.IsEmpty()
+        || id.find_first_not_of( wxS( "0123456789" ) ) != wxString::npos
+        || wxFileName( symbolPath ).GetFullName() != nickname + wxS( ".kicad_sym" )
+        || !wxFileExists( symbolPath ) || !wxDirExists( footprintPath ) )
+    {
+        aError = _( "The downloaded KiCad library paths are invalid." );
+        return false;
+    }
+
+    for( const auto& [type, path] : {
+            std::pair{ LIBRARY_TABLE_TYPE::SYMBOL, symbolPath },
+            std::pair{ LIBRARY_TABLE_TYPE::FOOTPRINT, footprintPath } } )
+    {
+        const wxFileName libraryPath = type == LIBRARY_TABLE_TYPE::FOOTPRINT
+                                              ? wxFileName::DirName( path ) : wxFileName( path );
+        auto existing = Pgm().GetLibraryManager().GetRow( type, nickname );
+        if( existing && !LIBRARY_MANAGER::UrisAreEquivalent(
+                                ( *existing )->URI(), libraryPath.GetFullPath() ) )
+        {
+            aError = _( "A different library already uses this Auto BOM library name." );
+            return false;
+        }
+        if( !EnsureRemoteLibraryEntry( type, libraryPath, nickname, true, true, aError ) )
+            return false;
+
+        // LoadSymbol only reads libraries already loaded by the adapter. A newly
+        // registered download must be loaded before the first placement.
+        if( type == LIBRARY_TABLE_TYPE::SYMBOL )
+        {
+            auto status = Pgm().GetLibraryManager().LoadLibraryEntry( type, nickname );
+            if( !status || status->load_status != LOAD_STATUS::LOADED )
+            {
+                aError = _( "KiCad could not load the downloaded symbol library." );
+                return false;
+            }
+        }
+    }
+    return true;
+}
