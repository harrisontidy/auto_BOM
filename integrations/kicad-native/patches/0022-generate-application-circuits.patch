+void PANEL_AUTO_BOM_ASSISTANT::generateApplication( size_t aCandidateIndex )
+{
+    if( m_busy || aCandidateIndex >= m_candidateJson.size() ) return;
+    const auto candidate = nlohmann::json::parse( m_candidateJson[aCandidateIndex] );
+    const auto component = nlohmann::json::parse( m_componentJson );
+    nlohmann::json request = { { "mode", "application" }, { "candidate", candidate }, { "component", component },
+        { "provider", m_providerCtrl->GetSelection() == 0 ? "codex" : "api" },
+        { "model", m_modelIds.at( m_modelCtrl->GetSelection() ) },
+        { "effort", m_effortIds.at( m_effortCtrl->GetSelection() ) } };
+    if( m_searchThread.joinable() ) { m_searchThread.request_stop(); m_searchThread.join(); }
+    m_pendingQuestion = "Generate typical application circuit for " + candidate.value( "manufacturerPartNumber", std::string() );
+    m_revealTimer.Stop(); m_revealAnswer.clear(); m_revealChars = 0;
+    setBusy( true ); renderConversation();
+    const uint64_t generation = ++m_searchGeneration;
+    m_searchThread = std::jthread( [this, generation, requestBody=request.dump()]( std::stop_token stop )
+    { runSearch( stop, generation, requestBody ); } );
 }
 
 
