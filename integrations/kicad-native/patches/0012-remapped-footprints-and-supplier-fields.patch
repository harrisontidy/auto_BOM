-{
+static bool registerAutoBomAssets( const nlohmann::json& aAssets, wxString& aError,
+                                   const wxString& aProjectDirectory = wxString() )
+{
+    if( aAssets.is_object() && aAssets.contains( "footprintRemap" ) )
+    {
+        const wxString source = jsonString( aAssets, "remappedFootprintPath" );
+        const wxString footprint = jsonString( aAssets, "footprintId" );
+        const wxString name = footprint.AfterFirst( ':' );
+        const wxString hash = name.Mid( 7 );
+        if( aProjectDirectory.IsEmpty() || !footprint.StartsWith( wxS( "AutoBOM_Mapped:Mapped_" ) )
+            || hash.length() != 16 || hash.find_first_not_of( wxS( "0123456789abcdef" ) ) != wxString::npos
+            || wxFileName( source ).GetFullName() != name + wxS( ".kicad_mod" )
+            || !wxFileExists( source ) )
+        {
+            aError = _( "The remapped footprint is invalid or the project has not been saved." );
+            return false;
+        }
+        const wxString directory = wxFileName::DirName( aProjectDirectory ).GetFullPath()
+                                   + wxS( "AutoBOM_Mapped.pretty" );
+        if( !wxDirExists( directory ) && !wxFileName::Mkdir( directory, wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL ) )
+        {
+            aError = _( "Could not create the project footprint library." );
+            return false;
+        }
+        const wxFileName destination( directory, name + wxS( ".kicad_mod" ) );
+        if( !wxFileExists( destination.GetFullPath() )
+            && !wxCopyFile( source, destination.GetFullPath(), false ) )
+        {
+            aError = _( "Could not copy the remapped footprint into the project." );
+            return false;
+        }
+        return EnsureRemoteLibraryEntry( LIBRARY_TABLE_TYPE::FOOTPRINT,
+                wxFileName::DirName( directory ), wxS( "AutoBOM_Mapped" ), false, true, aError );
+    }
     if( !aAssets.is_object() || !aAssets.value( "imported", false ) )
